---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = SITE_CONFIG.description,
  canonical = `${SITE_CONFIG.url}${Astro.url.pathname}`,
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sonia11',
  url: SITE_CONFIG.url,
  image: `${SITE_CONFIG.url}${SITE_CONFIG.images.profile}`,
  description: 'Sonia11.com — Linkuri oficiale și conținut exclusiv Sonia.',
  sameAs: [
    SITE_CONFIG.social.onlyfans,
    SITE_CONFIG.social.tiktok,
    // Instagram + Facebook comentate (dezactivate)
  ],
};
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Favicon (folosim profile image ca placeholder) -->
  <link rel="icon" type="image/jpeg" href="/sonia-profile-small.jpg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${SITE_CONFIG.url}${SITE_CONFIG.images.main}`} />
  <meta property="og:locale" content="ro_RO" />
  <meta property="og:site_name" content="Sonia11" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE_CONFIG.url}${SITE_CONFIG.images.main}`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Schema Person JSON-LD (global) -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />

  <slot name="head" />
</head>
<body>
  <div class="bg-orbs" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <main class="container">
    <slot />
  </main>

  <CookieBanner />
</body>
</html>
